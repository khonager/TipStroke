#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")"

case "${1:-help}" in
  build|apk)
    ./gradlew assembleDebug
    printf '\nAPK: app/build/outputs/apk/debug/app-debug.apk\n'
    ;;
  install)
    ./gradlew installDebug
    ;;
  laptop|desktop)
    if [ -e /etc/NIXOS ] && [ "${TIPSTROKE_NIX_SHELL:-}" != 1 ] && command -v nix >/dev/null 2>&1; then
      exec nix develop --command ./gradlew :desktop:run
    fi
    exec ./gradlew :desktop:run
    ;;
  desktop-package)
    if [ -e /etc/NIXOS ] && [ "${TIPSTROKE_NIX_SHELL:-}" != 1 ] && command -v nix >/dev/null 2>&1; then
      exec nix develop --command ./gradlew :desktop:createDistributable
    fi
    exec ./gradlew :desktop:createDistributable
    ;;
  emulator-setup|laptop-setup)
    if [ "${1:-}" = laptop-setup ]; then
      printf 'The native desktop app needs no setup. This legacy command sets up the optional Android emulator.\n'
    fi
    sh tools/laptop-emulator.sh setup
    ;;
  emulator|android-emulator)
    sh tools/laptop-emulator.sh run
    ;;
  test)
    ./gradlew test
    ;;
  brushes)
    ./gradlew :drawing-android:connectedDebugAndroidTest
    printf '\nBrush review images: drawing-android/build/outputs/connected_android_test_additional_output/\n'
    ;;
  check)
    ./gradlew test lint assembleDebug :desktop:jar
    ;;
  clean)
    ./gradlew clean
    ;;
  help|--help|-h)
    printf '%s\n' \
      'TipStroke developer commands:' \
      '  ./tipstroke build    Build a debug APK' \
      '  ./tipstroke install  Build and install on a connected phone/emulator' \
      '  ./tipstroke laptop   Run the native Linux desktop app' \
      '  ./tipstroke desktop-package  Build a self-contained desktop distribution' \
      '  ./tipstroke emulator-setup  Create the optional Android tablet emulator' \
      '  ./tipstroke emulator Build and run the Android app in that emulator' \
      '  ./tipstroke test     Run local tests' \
      '  ./tipstroke brushes  Render and verify production brushes on a connected device' \
      '  ./tipstroke check    Test, lint, and build' \
      '  ./tipstroke clean    Remove generated build output'
    ;;
  *)
    printf 'Unknown command: %s\n' "$1" >&2
    exit 2
    ;;
esac
